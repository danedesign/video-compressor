{
  "name": "sl-video-compressor",
  "version": "1.0.3",
  "description": "Local batch video compression with resolution and frame-rate preservation.",
  "author": "Stacked Learning",
  "main": "main.js",
  "private": true,
  "scripts": {
    "setup": "install-electron",
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "build": {
    "appId": "com.stackedlearning.video-compressor",
    "productName": "SL Video Compressor",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "compression-utils.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe"
      },
      {
        "from": "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe",
        "to": "ffprobe.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "licenses/FFmpeg-GPL-3.0.txt"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
        "to": "licenses/FFmpeg-Build-Info.txt"
      },
      {
        "from": "node_modules/ffprobe-static/LICENSE",
        "to": "licenses/ffprobe-static-MIT.txt"
      },
      {
        "from": "node_modules/ffprobe-static/README.md",
        "to": "licenses/ffprobe-static-Info.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "SL-Video-Compressor-${version}-x64.exe"
    }
  }
}
